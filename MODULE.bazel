### Toolchains

# Keep in sync with jax/version.py (_version) and python.defaults below.
DEFAULT_PYTHON_VERSION = "3.12"

JAXLIB_VERSION = "0.9.2"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.override(
    add_runtime_manifest_files = ["//third_party/py:rules_python_cpython_3_15.txt"],
    minor_mapping = {
        "3.15": "3.15.0rc1",
    },
)
python.defaults(
    # The environment variable takes precedence if set.
    python_version = DEFAULT_PYTHON_VERSION,
    python_version_env = "HERMETIC_PYTHON_VERSION",
)
python.toolchain(python_version = "3.12")
python.toolchain(python_version = "3.13")
python.toolchain(python_version = "3.14")
python.toolchain(python_version = "3.15")

### Pypi
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip", dev_dependency = True)

[pip.parse(
    download_only = True,
    experimental_index_url = "https://us-python.pkg.dev/ml-oss-artifacts-published/pypi-mirror/simple",
    extra_hub_aliases = {
        "numpy": ["numpy_headers"],
    },
    hub_name = "jax_pypi",
    local_wheels = {
        "jax": "dist/jax-*.whl",
        "jaxlib": "dist/jaxlib-*.whl",
        "jax-cuda12-pjrt": "dist/jax_cuda12_pjrt-*.whl",
        "jax-cuda12-plugin": "dist/jax_cuda12_plugin-*.whl",
        "jax-cuda13-pjrt": "dist/jax_cuda13_pjrt-*.whl",
        "jax-cuda13-plugin": "dist/jax_cuda13_plugin-*.whl",
        "libtpu": "dist/libtpu-*.whl",  # On CI, we use the downloaded nightly version of libtpu.
        "ml_dtypes": "dist/ml_dtypes-*.whl",
        "numpy": "dist/numpy-*.whl",  # On TSAN CI, we use a custom TSAN-instrumented NumPy wheel.
        "scipy": "dist/scipy-*.whl",
    },
    python_version = python_version,
    requirements_by_platform = {} if python_version in [
        "3.12",
        "3.13",
    ] else {
        "//build:requirements_lock_{}_ft.txt".format(python_version.replace(".", "_")): "linux_x86_64_freethreaded,windows_x86_64_freethreaded,linux_aarch64_freethreaded,osx_aarch64_freethreaded",
    },
    requirements_lock = "//build:requirements_lock_{}.txt".format(python_version.replace(".", "_")),
    target_platforms = [
        # Explicitly list both x86_64 and aarch64 to ensure cross-compilation works.
        "{os}_x86_64",
        "{os}_aarch64",
        "{os}_x86_64_freethreaded",
        "{os}_aarch64_freethreaded",
        "windows_aarch64",
    ],
    whl_modifications = {
        "//build:numpy.json": "numpy",  # @pypi_mods is defined in XLA's MODULE.bazel
    },
) for python_version in [
    "3.12",
    "3.13",
    "3.14",
    "3.15",
]]

use_repo(pip, "pypi_mods", pypi = "jax_pypi")

# Override XLA's pypi installation to use the one defined by JAX.
# TODO: have a better way to unify the pypi installation.
override_repo(
    pip,
    xla_pypi = "pypi",
)

