single_version_override(
    module_name = "rules_python",
    patch_strip = 1,
    # Remove the upstreamed patches (if any) when updating to a version that includes their PRs:
    # https://rules-python.readthedocs.io/en/latest/changelog.html
    patches = [
        "//third_party/py:rules_python_whl_abi_tags.patch",
        # Upstreamed at https://github.com/bazel-contrib/rules_python/pull/3768
        "//third_party/py:rules_python_local_wheel.patch",
        # Upstreamed: https://github.com/bazel-contrib/rules_python/pull/4071
        "//third_party/py:rules_python_windows_long_paths.patch",
        "//third_party/py:rules_python_pip_parse_windows_aarch64.patch",
        # Skip pip hubs for Python versions not available for Windows ARM64(Python 3.9 & 3.10)
        "//third_party/py:rules_python_skip_missing_interpreter.patch",
    ],
    version = "2.2.0",
)

single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = [
        "//third_party/protobuf:protobuf_arena.patch",
        "//third_party/protobuf:fix_message_lite_incomplete_type.patch",
